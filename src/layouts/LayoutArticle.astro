---
import "floating-vue/dist/style.css";
import "vueperslides/dist/vueperslides.css";
import LayoutCommon from "./common/LayoutCommon.astro";

export interface Props {
  title: string;
  lang: string;
  meta?: object[];
}

const { title, lang, meta } = Astro.props;
---

<LayoutCommon title={title} lang={lang} meta={meta}>
  <div class="w-full h-auto flex justify-between">
    <div class="w-[852px] min-h-[80vh]">
      <slot />
    </div>
    <div class="w-[300px] min-h-[80vh]">
      <slot name="side-ads" />
    </div>
  </div>
</LayoutCommon>
