---
import "floating-vue/dist/style.css";
import "vueperslides/dist/vueperslides.css";
import Header from "@astro-components/Header.astro";
import Footer from "@astro-components/Footer.astro";
export interface Props {
  title: string;
  lang: string;
  meta?: object[];
}

const { title, lang, meta } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {
      meta &&
        meta.map((item) => <meta name={item.name} content={item.content} />)
    }
    <title>{title}</title>
    <!--<script-->
    <!--  async-->
    <!--  src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2866636083559780"-->
    <!--  crossorigin="anonymous"></script>-->
  </head>
  <body class="w-screen h-auto min-h-screen bg-zinc-200">
    <div class="w-full min-h-screen flex flex-col items-center">
      <div class="xl:w-[1164px] lg:w-[852px] w-full">
        <Header />
        <div class="w-full min-h-[90vh]">
          <slot />
        </div>
      </div>
      <Footer />
    </div>
    <div
      class="from-[#0000FF] to-[#000040] text-[#000080] bg-[#000080] from-[#FFE6F2] to-[#FF7FC2] text-[#FFB3DE] bg-[#FFB3DE] from-[#D1FF80] to-[#6BB800] text-[#A7FC00] bg-[#A7FC00] from-[#0040BF] to-[#80BFFF] text-[#0080FF] bg-[#0080FF] from-[#FF80AF] to-[#BF005F] text-[#FF007F] bg-[#FF007F] from-[#FF4040] to-[#A60000] text-[#E62020] bg-[#E62020] from-[#FFF4FF] to-[#A69EBF] text-[#DCD0FF] bg-[#DCD0FF] from-[#C200FF] to-[#5C006B] text-[#8D029B] bg-[#8D029B] from-[#7FBF73] to-[#0F3D18] text-[#1B7931] bg-[#1B7931] from-[#A53C3E] to-[#3F0709] text-[#670E10] bg-[#670E10] from-[#FFE2C2] to-[#BF6D2F] text-[#FF9B49] bg-[#FF9B49] from-[#FFFFB2] to-[#BFBF33] text-[#FFFF66] bg-[#FFFF66] bg-[url('/assets/images/properties/pp_001.png')] bg-[url('/assets/images/properties/pp_002.png')] bg-[url('/assets/images/properties/pp_003.png')] bg-[url('/assets/images/properties/pp_004.png')] bg-[url('/assets/images/properties/pp_005.png')] bg-[url('/assets/images/properties/pp_006.png')] bg-[url('/assets/images/properties/pp_007.png')] bg-[url('/assets/images/properties/pp_008.png')] bg-[url('/assets/images/properties/pp_009.png')] bg-[url('/assets/images/properties/pp_010.png')] bg-[url('/assets/images/properties/pp_011.png')] bg-[url('/assets/images/properties/pp_012.png')] shadow-[#000080] shadow-[#FFB3DE] shadow-[#A7FC00] shadow-[#0080FF] shadow-[#FF007F] shadow-[#E62020] shadow-[#DCD0FF] shadow-[#8D029B] shadow-[#1B7931] shadow-[#670E10] shadow-[#FF9B49] shadow-[#FFFF66] text-[#ffffff] text-[#000000] bg-red-500 bg-orange-500 bg-yellow-500 bg-lime-500 bg-green-500 text-[#0000FF] text-[#000040] text-[#FFE6F2] text-[#FF7FC2] text-[#D1FF80] text-[#6BB800] text-[#0040BF] text-[#80BFFF] text-[#FF80AF] text-[#BF005F] text-[#FF4040] text-[#A60000] text-[#FFF4FF] text-[#A69EBF] text-[#C200FF] text-[#5C006B] text-[#7FBF73] text-[#0F3D18] text-[#A53C3E] text-[#3F0709] text-[#FFE2C2] text-[#BF6D2F] text-[#FFFFB2] text-[#BFBF33]"
      hidden
    >
    </div>
  </body>
</html>
<style is:global>
  :root {
    --accent: 124, 58, 237;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      #da62c4 30%,
      white 60%
    );
    scrollbar-width: thin;
    scrollbar-color: rgb(84, 136, 202) #f5f5f5;
  }
  html {
    font-family: system-ui, sans-serif;
    background-color: #f6f6f6;
  }
  code {
    font-family: Menlo, Monaco, Lucida Console, Liberation Mono,
      DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace;
  }

  ::-webkit-scrollbar-track {
    -webkit-box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
    background-color: #f5f5f5;
    border-radius: 10px;
  }

  ::-webkit-scrollbar {
    width: 5px;
    height: 5px;
    background-color: #f5f5f5;
  }

  ::-webkit-scrollbar-thumb {
    border-radius: 10px;
    background-image: -webkit-gradient(
      linear,
      left bottom,
      right top,
      color-stop(0.44, #cd5dca),
      color-stop(0.72, #4180f4)
    );
  }
</style>
