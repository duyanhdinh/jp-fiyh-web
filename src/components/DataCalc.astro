---
import DateDataForm from "./vue/DateDataForm.vue";
import HowToKnowYourself from "./vue/HowToKnowYourself.vue";
import HowToImproveYourself from "./vue/HowToImproveYourself.vue";
---

<div
  class="relative flex w-full h-[320px] bg-[url('/assets/images/banner.png')] bg-cover shadow-xl"
>
  <div class="absolute inset-0 w-full h-full z-100 bg-white/70"></div>
  <HowToKnowYourself class="relative w-[456px] h-full" />
  <div
    class="relative w-[252px] h-full border-l-2 border-r-2 border-indigo-500 bg-indigo-200/50"
  >
    <DateDataForm client:only="vue" />
  </div>
  <HowToImproveYourself class="relative w-[456px] h-full" />
</div>
