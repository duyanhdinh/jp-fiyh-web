---
import ArticlesListVue from "@vue-components/pages/articles/ArticlesListVue.vue";

export interface Props {
  data: any;
  parentUriList: string;
  parentUriArticles: string;
  resource: string;
}

const { data, parentUriList, parentUriArticles, resource } = Astro.props;
---

<div class="bg-white px-8 py-8 rounded-xl shadow-2xl">
  <ArticlesListVue
    data={data}
    parentUriList={parentUriList}
    parentUriArticles={parentUriArticles}
    resource={resource}
  />
</div>
