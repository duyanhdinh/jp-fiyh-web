---
import ArticlesListVue from "@vue-components/pages/articles/ArticlesListVue.vue";

export interface Props {
  data: any;
  resource: string;
  from: string;
}

const { data, resource, from } = Astro.props;
---

<div class="bg-white px-8 py-8 rounded-xl shadow-2xl">
  <ArticlesListVue data={data} resource={resource} from={from} client:only="vue" />
</div>
