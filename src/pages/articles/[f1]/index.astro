---
import { articlesListHandles } from "../../../astro/scripts/articles/list";
import LayoutArticle from "@/layouts/LayoutArticle.astro";
import ArticlesList from "@astro-components/pages/articles/ArticlesList.astro";
import { dictionary } from "@lang";

const { data, resource, from } = await articlesListHandles(Astro);
---

<LayoutArticle title={dictionary.site.title} lang={dictionary.language}>
  <ArticlesList data={data} resource={resource} from={from} />
</LayoutArticle>
