---
import { articlesListHandles } from "../../../astro/scripts/articles/list";
import LayoutArticle from "@/layouts/LayoutArticle.astro";
import ArticlesList from "@astro-components/pages/articles/ArticlesList.astro";

const { f1, f2 } = Astro.params;
const type = "F2";
const { data, parentUriList, parentUriArticles, resource } =
  await articlesListHandles(Astro, { type, f1, f2 });

if (data === null) return Astro.redirect("/articles");
---

<LayoutArticle>
  <ArticlesList
    data={data}
    parentUriList={parentUriList}
    parentUriArticles={parentUriArticles}
    resource={resource}
  />
</LayoutArticle>
