---
import { HTTP_STATUS_CODE } from "@/constant/http.constant";
import { getArticle } from "@/api/article/get.api";
import PageNotFound from "@astro-components/PageNotFound.astro";
import VueArticleContent from "@vue-components/pages/article/VueArticleContent.vue";
import LayoutArticle from "@/layouts/LayoutArticle.astro";
import SideAds from "@astro-components/layouts/SideAds.astro";
import { dictionary } from "../../../../locales/en/translation";

const { type, category, slug } = Astro.params;

const response = await getArticle({ type, category, slug });
const statusCode = response.statusCode;
const data = response?.data;

let title = dictionary.site.title;
let meta = [];

if (statusCode === HTTP_STATUS_CODE.SUCCESS) {
  title = data.contentData.title + " | " + title;

  meta = [
    {
      name: "description",
      content: data.contentData.meta,
    },
    {
      name: "canonical",
      content: `${import.meta.env.PUBLIC_HOST}${Astro.url.pathname}`,
    },
  ];
}
---

{statusCode !== HTTP_STATUS_CODE.SUCCESS && <PageNotFound />}

{
  statusCode === HTTP_STATUS_CODE.SUCCESS && (
    <LayoutArticle
      title={data.contentData.title}
      lang={dictionary.language}
      meta={meta}
    >
      <VueArticleContent content={data.contentData} />
      <SideAds slot="side-ads" type={type} category={category} slug={slug} />
    </LayoutArticle>
  )
}
