---
import Layout from "@/layouts/Layout.astro";
import ResultSummary from "@vue-components/pages/result/ResultSummary.vue";
import ResultAstro from "@vue-components/pages/result/ResultAstro.vue";
import ResultEnergy from "@vue-components/pages/result/ResultEnergy.vue";
import { dictionary } from "@lang";
import { apiDiscoverGetResult } from "../../api/discover/discover.api";
import { getLocaleDateString } from "@helpers/date.helper";
import DataCalc from "@astro-components/layouts/DataCalc.astro";
import DataFromSideAds from "@vue-components/ads/DataFromSideAds.vue";
import AdsMobileAtAboveArticle from "@vue-components/ads/AdsMobileAtAboveArticle.vue";

const request = {
  year: Astro.url.searchParams.get("y"),
  month: Astro.url.searchParams.get("m"),
  day: Astro.url.searchParams.get("d"),
  lat: Astro.url.searchParams.get("lat"),
  lng: Astro.url.searchParams.get("lng"),
  hour: Astro.url.searchParams.get("h"),
  min: Astro.url.searchParams.get("min"),
  co: Astro.url.searchParams.get("co"),
};

const data = await apiDiscoverGetResult(request);

if (data === undefined) return Astro.redirect("/");

const date = getLocaleDateString(new Date(data.birth_time), {
  timeZone: data.birth_time_zone,
});

const meta = [
  {
    name: "description",
    content: dictionary.meta.result,
  },
  {
    name: "canonical",
    content: import.meta.env.PUBLIC_HOST + "/",
  },
];
---

<Layout title={dictionary.site.title} lang={dictionary.language} meta={meta}>
  <DataCalc class="hidden xl:flex" />
  <!--todo:-->
  <!--<AdsMobileAtAboveArticle class="xl:hidden" client:load />-->
  <div
    class="flex xl:hidden justify-center w-full h-[390px] bg-white px-4 pt-2 pb-6 rounded-xl shadow-2xl select-none leading-loose text-justify bg-gradient-to-r from-[#CD5DCA]/30 to-[#4180F4]/30"
  >
    <div class="w-[300px]">
      <DataFromSideAds client:only="vue" />
    </div>
  </div>

  <h1 class="w-full text-center font-bold text-[20px] mt-[16px]">
    {dictionary.result.title(date)}
  </h1>
  <ResultSummary
    class="mt-[16px]"
    client:load
    score={data.score}
    data={data}
    request={request}
  />
  <ResultAstro class="mt-[16px]" client:load data={data} />

  <!--todo:-->
  <!--<div class="mt-[16px]"></div>-->
  <!--<ins class="adsbygoogle"-->
  <!--     style="display:block"-->
  <!--     data-ad-format="fluid"-->
  <!--     data-ad-layout-key="-g0-l+7p-8k-bk"-->
  <!--     data-ad-client="ca-pub-2866636083559780"-->
  <!--     data-ad-slot="7050371651"-->
  <!--&gt;</ins>-->
  <!--<script>-->
  <!--  (adsbygoogle = window.adsbygoogle || []).push({});-->
  <!--</script>-->

  <ResultEnergy class="mt-[16px]" client:load energy={data.energy} />
</Layout>
